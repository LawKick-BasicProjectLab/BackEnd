# ===== Law-Kick Backend 환경변수 예시 =====
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 절대 커밋하지 마세요. (.gitignore에 .env* 포함, .env.example만 예외)

# --- LLM (FactChat 게이트웨이 경유 Gemini) ---
# 발급받은 API 키. 값은 팀 비밀번호 관리 도구로 공유하고, 코드·채팅·이슈에 붙여넣지 마세요.
FACTCHAT_API_KEY=
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai
# 현재 코드에 하드코딩된 모델명을 옮겨 적으세요. 실제로 사용 가능한 모델명인지 확인 필요.
LLM_MODEL=gemini-3.5-flash

# --- CORS (프론트와 백엔드를 다른 도메인에 배포할 경우) ---
# ALLOWED_ORIGIN=http://localhost:3000

# --- DB (Supabase) ---
# Project Settings → Data API 의 Project URL
SUPABASE_URL=
# Project Settings → API Keys 의 secret 키 (sb_secret_...) 또는 legacy service_role 키
# 관리자 권한 키라 절대 공유·커밋하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# (선택) 맞춤 문제가 해금되는 풀이 횟수. 기본 10
# CUSTOM_UNLOCK_THRESHOLD=10

# --- 인증 (서버 인증 도입 시) ---
# JWT_SECRET=
